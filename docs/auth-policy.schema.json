{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ponchia/vaultwarden-eso-provider/blob/main/docs/auth-policy.schema.json",
  "title": "Vaultwarden ESO Provider capability-scoped auth policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities"],
  "properties": {
    "version": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tokens"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 32,
              "maxLength": 4096,
              "pattern": "^[!-~]+$"
            }
          },
          "allowedKeys": {
            "$ref": "#/definitions/selectors"
          },
          "allowedKeyPrefixes": {
            "$ref": "#/definitions/selectors"
          }
        },
        "anyOf": [
          {
            "required": ["allowedKeys"],
            "properties": {
              "allowedKeys": {
                "minItems": 1
              }
            }
          },
          {
            "required": ["allowedKeyPrefixes"],
            "properties": {
              "allowedKeyPrefixes": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "selectors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    }
  }
}
